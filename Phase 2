/**
 * PHASE 2 - BLANK ADDRESS REMOVAL & BASIC DATA CLEANUP
 *
 * Run this ONCE after Phase 1, with the donor data worksheet active.
 *
 * What it does:
 *   1. Moves rows with an empty Billing Street to the
 *      "Blank Addresses" sheet (original columns only)
 *   2. Cleans extra spaces / invisible characters in text columns
 *   3. Fixes ALL CAPS / lowercase in Billing Street and Billing City
 *
 * Raw Backup is never touched.
 */

type Cell = string | number | boolean;

// --------------------------------------------------
// SETTINGS
// --------------------------------------------------

const BACKUP_SHEET = "Raw Backup";
const BLANK_ADDRESSES_SHEET = "Blank Addresses";

const SPACE_CLEAN_COLUMNS: string[] = [
  "Account Name",
  "Formal Greeting",
  "Informal Greeting",
  "Billing Street",
  "Billing City",
  "Billing State/Province",
  "Billing Country"
];

const CASE_FIX_COLUMNS: string[] = [
  "Billing Street",
  "Billing City"
];

const DIRECTIONALS: string[] = [
  "N", "S", "E", "W",
  "NE", "NW", "SE", "SW"
];

// --------------------------------------------------
// HELPERS
// --------------------------------------------------

function colIndex(headers: string[], name: string): number {
  const idx = headers.indexOf(name);

  if (idx === -1) {
    throw new Error(`Column not found: "${name}"`);
  }

  return idx;
}

function cleanSpaces(value: string): string {
  return value
    .replace(/[\u200B\uFEFF]/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

function capWord(word: string): string {
  const lower = word.toLowerCase();

  if (/^mc[a-z]/.test(lower)) {
    return (
      "Mc" +
      lower.charAt(2).toUpperCase() +
      lower.substring(3)
    );
  }

  if (/^[a-z]'[a-z]/.test(lower)) {
    return (
      lower.charAt(0).toUpperCase() +
      "'" +
      lower.charAt(2).toUpperCase() +
      lower.substring(3)
    );
  }

  return lower.replace(/^[a-z]/, c => c.toUpperCase());
}

function properCaseToken(token: string): string {
  if (!token) return token;

  const upper = token.replace(/\./g, "").toUpperCase();

  if (DIRECTIONALS.indexOf(upper) !== -1) {
    return upper;
  }

  if (upper === "PO") {
    return "PO";
  }

  // 1st, 2nd, 3rd, 4th
  if (/^\d+(ST|ND|RD|TH)$/i.test(token)) {
    return token.toLowerCase();
  }

  // Unit numbers like 4B, 12A
  if (/\d/.test(token)) {
    return token.toUpperCase();
  }

  return token
    .split("-")
    .map(part => capWord(part))
    .join("-");
}

function properCase(value: string): string {
  return value
    .split(" ")
    .map(token => properCaseToken(token))
    .join(" ");
}

function needsCaseFix(value: string): boolean {
  if (!/[A-Za-z]/.test(value)) {
    return false;
  }

  return (
    value === value.toUpperCase() ||
    value === value.toLowerCase()
  );
}

// --------------------------------------------------
// MAIN
// --------------------------------------------------

function main(workbook: ExcelScript.Workbook): void {
  const dataSheet = workbook.getActiveWorksheet();
  const sheetName = dataSheet.getName();

  if (
    sheetName === BACKUP_SHEET ||
    sheetName === BLANK_ADDRESSES_SHEET
  ) {
    throw new Error("Activate the donor data sheet first.");
  }

  if (!workbook.getWorksheet(BACKUP_SHEET)) {
    throw new Error("Run Phase 1 first.");
  }

  const blankSheet = workbook.getWorksheet(BLANK_ADDRESSES_SHEET);

  if (!blankSheet) {
    throw new Error(
      `"${BLANK_ADDRESSES_SHEET}" sheet is missing. Run Phase 1 first.`
    );
  }

  const used = dataSheet.getUsedRange();

  if (!used) {
    throw new Error("No data found.");
  }

  const values = used.getValues();

  const headers = values[0].map(v => String(v).trim());

  // Phase 1 adds helper columns after the original data columns,
  // so everything left of "Original Row" is the original record.
  const cOrig = colIndex(headers, "Original Row");
  const originalColumnCount = cOrig;

  const cStreet = colIndex(headers, "Billing Street");

  const spaceCols = SPACE_CLEAN_COLUMNS.map(h => colIndex(headers, h));
  const caseCols = CASE_FIX_COLUMNS.map(h => colIndex(headers, h));

  const kept: Cell[][] = [];
  const blankRows: Cell[][] = [];

  for (let i = 1; i < values.length; i++) {
    const row = [...values[i]];

    const street = cleanSpaces(String(row[cStreet] ?? ""));

    // ----------------------------------
    // MOVE BLANK STREET ROWS
    // ----------------------------------

    if (street === "") {
      blankRows.push(row.slice(0, originalColumnCount));
      continue;
    }

    // ----------------------------------
    // WHITESPACE CLEANUP
    // ----------------------------------

    for (const col of spaceCols) {
      const value = row[col];

      if (typeof value === "string") {
        row[col] = cleanSpaces(value);
      }
    }

    // ----------------------------------
    // ADDRESS CAPITALIZATION
    // ----------------------------------

    for (const col of caseCols) {
      const value = row[col];

      if (typeof value === "string" && needsCaseFix(value)) {
        row[col] = properCase(value);
      }
    }

    kept.push(row);
  }

  // ----------------------------------
  // REWRITE DATA SHEET
  // ----------------------------------

  // Clear contents only, so header styling and number formats stay.
  used.clear(ExcelScript.ClearApplyTo.contents);

  const rebuilt: Cell[][] = [headers, ...kept];

  dataSheet
    .getRangeByIndexes(
      0,
      0,
      rebuilt.length,
      headers.length
    )
    .setValues(rebuilt);

  // ----------------------------------
  // WRITE BLANK ADDRESSES
  // ----------------------------------

  if (blankRows.length > 0) {
    const blankUsed = blankSheet.getUsedRange();
    const nextRow = blankUsed ? blankUsed.getRowCount() : 1;

    blankSheet
      .getRangeByIndexes(
        nextRow,
        0,
        blankRows.length,
        originalColumnCount
      )
      .setValues(blankRows);
  }

  console.log(
    `PHASE 2 COMPLETE

Rows moved to ${BLANK_ADDRESSES_SHEET}: ${blankRows.length}
Remaining rows: ${kept.length}`
  );
}
