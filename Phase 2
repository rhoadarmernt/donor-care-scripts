/**
 * PHASE 2 - BLANK ADDRESS REMOVAL & BASIC DATA CLEANUP
 */

type Cell = string | number | boolean;

const BACKUP_SHEET = "Raw Backup";
const LOG_SHEET = "Changes Log";
const SUMMARY_SHEET = "Summary";
const DELETED_SHEET = "Deleted Rows";

const LOG_HEADERS = [
  "Original Row",
  "Account Case Safe ID",
  "Column",
  "Original Value",
  "New Value",
  "Rule Triggered",
  "Action",
  "Timestamp"
];

const SPACE_CLEAN_COLUMNS = [
  "Account Name",
  "Formal Greeting",
  "Informal Greeting",
  "Billing Street",
  "Billing City",
  "Billing State/Province",
  "Billing Country"
];

const CASE_FIX_COLUMNS = [
  "Billing Street",
  "Billing City"
];

// --------------------------------------------------
// HELPERS
// --------------------------------------------------

function formatTimestamp(): string {
  const d = new Date();

  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  const dd = String(d.getDate()).padStart(2, "0");

  const hh = String(d.getHours()).padStart(2, "0");
  const min = String(d.getMinutes()).padStart(2, "0");

  return `${yyyy}-${mm}-${dd} ${hh}:${min}`;
}

function appendLog(
  log: ExcelScript.Worksheet,
  entries: Cell[][]
): void {
  if (entries.length === 0) return;

  const nextRow =
    log.getUsedRange().getRowCount();

  log
    .getRangeByIndexes(
      nextRow,
      0,
      entries.length,
      LOG_HEADERS.length
    )
    .setValues(entries);
}

function appendSummary(
  summary: ExcelScript.Worksheet,
  rows: Cell[][]
): void {
  if (rows.length === 0) return;

  const nextRow =
    summary.getUsedRange().getRowCount();

  summary
    .getRangeByIndexes(
      nextRow,
      0,
      rows.length,
      2
    )
    .setValues(rows);
}

function logRow(
  originalRow: Cell,
  accountId: Cell,
  column: string,
  oldValue: Cell,
  newValue: Cell,
  rule: string,
  action: string
): Cell[] {
  return [
    originalRow,
    accountId,
    column,
    oldValue,
    newValue,
    rule,
    action,
    formatTimestamp()
  ];
}

function colIndex(
  headers: string[],
  name: string
): number {
  const idx = headers.indexOf(name);

  if (idx === -1) {
    throw new Error(
      `Column not found: "${name}"`
    );
  }

  return idx;
}

// --------------------------------------------------
// TEXT FUNCTIONS
// --------------------------------------------------

function cleanSpaces(
  value: string
): string {
  return value
    .replace(/[\u200B\uFEFF]/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

const DIRECTIONALS = [
  "N", "S", "E", "W",
  "NE", "NW", "SE", "SW"
];

function capWord(
  word: string
): string {
  const lower = word.toLowerCase();

  if (/^mc[a-z]/.test(lower)) {
    return (
      "Mc" +
      lower.charAt(2).toUpperCase() +
      lower.substring(3)
    );
  }

  if (/^[a-z]'[a-z]/.test(lower)) {
    return (
      lower.charAt(0).toUpperCase() +
      "'" +
      lower.charAt(2).toUpperCase() +
      lower.substring(3)
    );
  }

  return lower.replace(
    /^[a-z]/,
    c => c.toUpperCase()
  );
}

function properCaseToken(
  token: string
): string {
  if (!token) return token;

  const bare =
    token.replace(/\./g, "");

  const upper =
    bare.toUpperCase();

  if (
    DIRECTIONALS.indexOf(upper) !== -1
  ) {
    return upper;
  }

  if (upper === "PO") {
    return "PO";
  }

  if (
    /^\d+(ST|ND|RD|TH)$/i.test(token)
  ) {
    return token.toLowerCase();
  }

  if (/\d/.test(token)) {
    return token.toUpperCase();
  }

  return token
    .split("-")
    .map(part => capWord(part))
    .join("-");
}

function properCase(
  value: string
): string {
  return value
    .split(" ")
    .map(token => properCaseToken(token))
    .join(" ");
}

function needsCaseFix(
  value: string
): boolean {
  if (!/[A-Za-z]/.test(value)) {
    return false;
  }

  return (
    value === value.toUpperCase() ||
    value === value.toLowerCase()
  );
}

// --------------------------------------------------
// MAIN
// --------------------------------------------------

function main(
  workbook: ExcelScript.Workbook
) {
  const dataSheet =
    workbook.getActiveWorksheet();

  const sheetName =
    dataSheet.getName();

  if (
    [
      BACKUP_SHEET,
      LOG_SHEET,
      SUMMARY_SHEET,
      DELETED_SHEET
    ].includes(sheetName)
  ) {
    throw new Error(
      "Activate the donor data sheet first."
    );
  }

  if (
    !workbook.getWorksheet(
      BACKUP_SHEET
    )
  ) {
    throw new Error(
      "Run Phase 1 first."
    );
  }

  const log =
    workbook.getWorksheet(
      LOG_SHEET
    );

  const summary =
    workbook.getWorksheet(
      SUMMARY_SHEET
    );

  const deletedSheet =
    workbook.getWorksheet(
      DELETED_SHEET
    );

  if (
    !log ||
    !summary ||
    !deletedSheet
  ) {
    throw new Error(
      "Changes Log, Summary, or Deleted Rows sheet missing."
    );
  }

  const used =
    dataSheet.getUsedRange();

  if (!used) {
    throw new Error("No data found.");
  }

  const values =
    used.getValues();

  const headers =
    values[0].map(v =>
      String(v).trim()
    );

  const cOrig =
    colIndex(headers, "Original Row");

  const originalColumnCount =
    cOrig;

  const cId =
    colIndex(
      headers,
      "Account Case Safe ID"
    );

  const cStreet =
    colIndex(
      headers,
      "Billing Street"
    );

  const entries: Cell[][] = [];
  const kept: Cell[][] = [];
  const deletedRows: Cell[][] = [];

  let deletedCount = 0;
  let spaceFixes = 0;
  let caseFixes = 0;

  const spaceCols =
    SPACE_CLEAN_COLUMNS.map(
      h => colIndex(headers, h)
    );

  const caseCols =
    CASE_FIX_COLUMNS.map(
      h => colIndex(headers, h)
    );

  for (
    let i = 1;
    i < values.length;
    i++
  ) {
    const row = [...values[i]];

    const street =
      cleanSpaces(
        String(
          row[cStreet] ?? ""
        )
      );

    // ----------------------------------
    // DELETE BLANK STREET ROWS
    // ----------------------------------

    if (street === "") {
      deletedCount++;

      const originalRecord =
        row.slice(
          0,
          originalColumnCount
        );

      deletedRows.push([
        "Blank Billing Street",
        formatTimestamp(),
        ...originalRecord
      ]);

      entries.push(
        logRow(
          row[cOrig],
          row[cId],
          "ROW SNAPSHOT",
          JSON.stringify(
            originalRecord
          ),
          "(row deleted)",
          "Blank Billing Street",
          "Deleted"
        )
      );

      continue;
    }

    const originalRow =
      row[cOrig];

    const accountId =
      row[cId];

    // ----------------------------------
    // WHITESPACE CLEANUP
    // ----------------------------------

    for (const col of spaceCols) {
      const value = row[col];

      if (
        typeof value !== "string"
      ) {
        continue;
      }

      const cleaned =
        cleanSpaces(value);

      if (cleaned !== value) {
        row[col] = cleaned;

        spaceFixes++;

        entries.push(
          logRow(
            originalRow,
            accountId,
            headers[col],
            value,
            cleaned,
            "Whitespace cleanup",
            "Auto-fixed"
          )
        );
      }
    }

    // ----------------------------------
    // ADDRESS CAPITALIZATION
    // ----------------------------------

    for (const col of caseCols) {
      const value = row[col];

      if (
        typeof value !== "string" ||
        !needsCaseFix(value)
      ) {
        continue;
      }

      const fixed =
        properCase(value);

      if (fixed !== value) {
        row[col] = fixed;

        caseFixes++;

        entries.push(
          logRow(
            originalRow,
            accountId,
            headers[col],
            value,
            fixed,
            "Fix ALL CAPS / lowercase",
            "Auto-fixed"
          )
        );
      }
    }

    kept.push(row);
  }

  const rebuilt = [
    headers,
    ...kept
  ];

  dataSheet
    .getUsedRange()
    ?.clear();

  dataSheet
    .getRangeByIndexes(
      0,
      0,
      rebuilt.length,
      rebuilt[0].length
    )
    .setValues(rebuilt);

  if (deletedRows.length > 0) {
    const nextDeletedRow =
      deletedSheet
        .getUsedRange()
        .getRowCount();

    deletedSheet
      .getRangeByIndexes(
        nextDeletedRow,
        0,
        deletedRows.length,
        deletedRows[0].length
      )
      .setValues(deletedRows);
  }

  appendLog(log, entries);

  appendSummary(summary, [
    ["Phase 2: rows deleted", deletedCount],
    ["Phase 2: whitespace fixes", spaceFixes],
    ["Phase 2: capitalization fixes", caseFixes],
    ["Data rows after Phase 2", kept.length]
  ]);

  console.log(
    `PHASE 2 COMPLETE

Rows deleted: ${deletedCount}
Whitespace fixes: ${spaceFixes}
Capitalization fixes: ${caseFixes}
Remaining rows: ${kept.length}`
  );
}
