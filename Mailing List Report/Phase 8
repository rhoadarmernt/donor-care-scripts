/**
 * PHASE 8 - DUPLICATE ADDRESSES & HOUSEHOLD MERGE
 *
 * Run this ONCE after Phase 7, with the donor data worksheet active.
 *
 * What it does:
 *   1. Finds rows that share the same address (normalized Billing
 *      Street + 5-digit ZIP, or + city when there is no ZIP)
 *   2. Moves all of those rows to a "Duplicate Addresses" tab
 *   3. Within each shared address, accounts with the same last name
 *      (last word of Formal Greeting) are merged into ONE row whose
 *      Account Name, Formal Greeting, and Informal Greeting are all
 *      "[Last Name] Household"
 *   4. Accounts at the same address with different last names stay as
 *      separate rows, next to each other
 *
 * Merged row details:
 *   - The surviving row is the one with the most recent Last Activity
 *     (ties go to the earlier row). All other columns come from it.
 *   - The extra "Merged From (Original Rows)" column lists the
 *     Original Row numbers that were combined (look them up in
 *     Raw Backup).
 *
 * Last names are never merged when the last word is in
 * SKIP_LAST_WORDS (LLC, Trust, Foundation, Family, etc.); those rows
 * stay unmerged for manual review.
 *
 * Moved rows keep the original columns only, plus the extra column.
 */

type Cell = string | number | boolean;

// --------------------------------------------------
// SETTINGS
// --------------------------------------------------

const BACKUP_SHEET = "Raw Backup";
const BLANK_ADDRESSES_SHEET = "Blank Addresses";
const ONE_WORD_SHEET = "One Word Address";
const CITY_IN_ADDRESS_SHEET = "City in Address";
const APT_UNIT_SHEET = "Apt-Unit Duplicated";
const NON_ZIP4_SHEET = "Non-Zip+4 Addresses";
const FOUNDATION_ESTATE_SHEET = "Foundation or Estate";
const TRUST_SHEET = "Trust";
const CAPITALIZATION_SHEET = "Greeting Capitalization";
const DUPLICATE_ADDRESSES_SHEET = "Duplicate Addresses";

const MERGED_FROM_HEADER = "Merged From (Original Rows)";

/**
 * When every account being merged has the exact same Formal Greeting
 * (for example two identical "John Smith" records), it is most likely
 * one person imported twice, not a household. If true, those rows are
 * merged into one but keep their existing names. Set to false to turn
 * them into "[Last Name] Household" like everything else.
 */
const IDENTICAL_NAMES_STAY_AS_IS = true;

// Ignored when finding the last name (John Smith Jr. -> Smith).
const NAME_SUFFIXES: string[] = [
  "JR", "SR", "II", "III", "IV", "MD", "PHD", "ESQ"
];

// If the last word is one of these, it is not a person's last name,
// so the row is never merged.
const SKIP_LAST_WORDS: string[] = [
  "LLC", "INC", "CORP", "LLP", "LP", "TRUST", "FOUNDATION",
  "ESTATE", "COMPANY", "FAMILY", "HOUSEHOLD", "FUND"
];

const HEADER_COLOR = "#D9E1F2";
const DUPLICATES_TAB_COLOR = "#C00000";

// --------------------------------------------------
// HELPERS
// --------------------------------------------------

function colIndex(headers: string[], name: string): number {
  const idx = headers.indexOf(name);

  if (idx === -1) {
    throw new Error(`Column not found: "${name}"`);
  }

  return idx;
}

function getOrCreateReviewSheet(
  workbook: ExcelScript.Workbook,
  name: string,
  headers: string[],
  tabColor: string
): ExcelScript.Worksheet {
  let sheet = workbook.getWorksheet(name);

  if (!sheet) {
    sheet = workbook.addWorksheet(name);

    const headerRange = sheet.getRangeByIndexes(0, 0, 1, headers.length);

    headerRange.setValues([headers]);
    headerRange.getFormat().getFont().setBold(true);
    headerRange.getFormat().getFill().setColor(HEADER_COLOR);

    sheet.getFreezePanes().freezeRows(1);
    sheet.setTabColor(tabColor);
  }

  return sheet;
}

function appendRows(
  sheet: ExcelScript.Worksheet,
  rows: Cell[][],
  columnCount: number
): void {
  if (rows.length === 0) {
    return;
  }

  const used = sheet.getUsedRange();
  const nextRow = used ? used.getRowCount() : 1;

  sheet
    .getRangeByIndexes(nextRow, 0, rows.length, columnCount)
    .setValues(rows);
}

function normalizeSpaces(value: string): string {
  return value.replace(/\s+/g, " ").trim();
}

function normalizeStreet(street: Cell): string {
  return String(street ?? "")
    .toUpperCase()
    .replace(/[.,]/g, "")
    .replace(/#\s*/g, " APT ")
    .replace(/\s+/g, " ")
    .trim()
    .replace(/\bSTREET\b/g, "ST")
    .replace(/\bAVENUE\b/g, "AVE")
    .replace(/\bROAD\b/g, "RD")
    .replace(/\bDRIVE\b/g, "DR")
    .replace(/\bLANE\b/g, "LN")
    .replace(/\bBOULEVARD\b/g, "BLVD")
    .replace(/\bCOURT\b/g, "CT")
    .replace(/\bPLACE\b/g, "PL")
    .replace(/\bCIRCLE\b/g, "CIR")
    .replace(/\bHIGHWAY\b/g, "HWY")
    .replace(/\bPARKWAY\b/g, "PKWY")
    .replace(/\bAPARTMENT\b/g, "APT")
    .replace(/\bSUITE\b/g, "STE");
}

function capitalizeNamePart(part: string): string {
  if (!part) {
    return part;
  }

  const lower = part.toLowerCase();

  // McDonald, McArthur, McKinley
  if (/^mc[a-z]/.test(lower)) {
    return (
      "Mc" +
      lower.charAt(2).toUpperCase() +
      lower.substring(3)
    );
  }

  // O'Brien, D'Angelo
  if (/^[a-z]'[a-z]/.test(lower)) {
    return (
      lower.charAt(0).toUpperCase() +
      "'" +
      lower.charAt(2).toUpperCase() +
      lower.substring(3)
    );
  }

  return lower.charAt(0).toUpperCase() + lower.substring(1);
}

/**
 * Last name = last word of the Formal Greeting, ignoring suffixes
 * like Jr. and III. Returns "" when it can't be determined.
 */
function getLastName(formal: string): string {
  const words = normalizeSpaces(formal)
    .split(" ")
    .map(w => w.replace(/[.,;:]+$/g, ""))
    .filter(w => w !== "");

  if (words.length < 2) {
    return "";
  }

  while (
    words.length > 1 &&
    NAME_SUFFIXES.indexOf(words[words.length - 1].toUpperCase()) !== -1
  ) {
    words.pop();
  }

  if (words.length < 2) {
    return "";
  }

  return words[words.length - 1];
}

/** Fixes ALL CAPS / lowercase last names; leaves mixed case alone. */
function formatLastName(word: string): string {
  if (word === word.toUpperCase() || word === word.toLowerCase()) {
    return word
      .split("-")
      .map(part => capitalizeNamePart(part))
      .join("-");
  }

  return word;
}

function toTime(value: Cell): number {
  if (typeof value === "number") {
    return value;
  }

  if (typeof value === "string") {
    const parsed = Date.parse(value);

    return isNaN(parsed) ? -Infinity : parsed;
  }

  return -Infinity;
}

function toOrder(value: Cell): number {
  const n = Number(value);

  return isNaN(n) || String(value ?? "").trim() === ""
    ? Number.MAX_SAFE_INTEGER
    : n;
}

// --------------------------------------------------
// MAIN
// --------------------------------------------------

function main(workbook: ExcelScript.Workbook): void {
  const dataSheet = workbook.getActiveWorksheet();
  const sheetName = dataSheet.getName();

  if (
    [
      BACKUP_SHEET,
      BLANK_ADDRESSES_SHEET,
      ONE_WORD_SHEET,
      CITY_IN_ADDRESS_SHEET,
      APT_UNIT_SHEET,
      NON_ZIP4_SHEET,
      FOUNDATION_ESTATE_SHEET,
      TRUST_SHEET,
      CAPITALIZATION_SHEET,
      DUPLICATE_ADDRESSES_SHEET
    ].includes(sheetName)
  ) {
    throw new Error("Activate the donor data sheet first.");
  }

  if (!workbook.getWorksheet(BACKUP_SHEET)) {
    throw new Error("Run Phase 1 first.");
  }

  const used = dataSheet.getUsedRange();

  if (!used) {
    throw new Error("No data found.");
  }

  const values = used.getValues() as Cell[][];

  if (values.length < 2) {
    throw new Error("The sheet needs headers and at least one data row.");
  }

  const headers = values[0].map(v => String(v).trim());

  // Phase 1 adds helper columns after the original data columns,
  // so everything left of "Original Row" is the original record.
  const cOrig = colIndex(headers, "Original Row");
  const originalColumnCount = cOrig;
  const originalHeaders = headers.slice(0, originalColumnCount);

  const cAccountName = colIndex(headers, "Account Name");
  const cFormal = colIndex(headers, "Formal Greeting");
  const cInformal = colIndex(headers, "Informal Greeting");
  const cStreet = colIndex(headers, "Billing Street");
  const cCity = colIndex(headers, "Billing City");
  const cZip = colIndex(headers, "Billing Zip/Postal Code");
  const cLastActivity = colIndex(headers, "Last Activity");

  const rows: Cell[][] = values.slice(1);

  // ----------------------------------
  // GROUP ROWS BY ADDRESS
  // ----------------------------------

  const addressGroups = new Map<string, number[]>();

  rows.forEach((row, index) => {
    const street = normalizeStreet(row[cStreet]);

    if (street === "") {
      return;
    }

    const zip5 = String(row[cZip] ?? "").replace(/\D/g, "").slice(0, 5);

    const place =
      zip5 !== ""
        ? zip5
        : normalizeSpaces(String(row[cCity] ?? "")).toUpperCase();

    const key = `${street}|${place}`;

    const list = addressGroups.get(key) ?? [];
    list.push(index);
    addressGroups.set(key, list);
  });

  // ----------------------------------
  // BUILD OUTPUT FOR EACH SHARED ADDRESS
  // ----------------------------------

  const movedIndexes = new Set<number>();

  const groupOutputs: {
    sortKey: number;
    entries: { order: number; row: Cell[] }[];
  }[] = [];

  let addressGroupCount = 0;
  let householdsMerged = 0;
  let accountsCombined = 0;

  addressGroups.forEach(indexes => {
    if (indexes.length < 2) {
      return;
    }

    addressGroupCount++;

    // Group this address's rows by last name.
    const byLastName = new Map<string, number[]>();

    for (const idx of indexes) {
      movedIndexes.add(idx);

      const lastName = getLastName(String(rows[idx][cFormal] ?? ""));
      const upper = lastName.toUpperCase();

      if (lastName === "" || SKIP_LAST_WORDS.indexOf(upper) !== -1) {
        continue;
      }

      const list = byLastName.get(upper) ?? [];
      list.push(idx);
      byLastName.set(upper, list);
    }

    const entries: { order: number; row: Cell[] }[] = [];
    const inMergedGroup = new Set<number>();

    byLastName.forEach(members => {
      if (members.length < 2) {
        return;
      }

      // Survivor = most recent Last Activity (ties: earliest row).
      let survivorIdx = members[0];
      let bestTime = toTime(rows[survivorIdx][cLastActivity]);

      for (const idx of members.slice(1)) {
        const time = toTime(rows[idx][cLastActivity]);

        if (time > bestTime) {
          bestTime = time;
          survivorIdx = idx;
        }
      }

      const record = rows[survivorIdx].slice(0, originalColumnCount);

      const distinctFormals = new Set<string>(
        members.map(idx =>
          normalizeSpaces(String(rows[idx][cFormal] ?? "")).toLowerCase()
        )
      );

      const sameNameEverywhere = distinctFormals.size === 1;

      if (!(sameNameEverywhere && IDENTICAL_NAMES_STAY_AS_IS)) {
        const lastName = formatLastName(
          getLastName(String(rows[survivorIdx][cFormal] ?? ""))
        );

        const householdName = `${lastName} Household`;

        record[cAccountName] = householdName;
        record[cFormal] = householdName;
        record[cInformal] = householdName;
      }

      const mergedFrom = members
        .map(idx => String(rows[idx][cOrig] ?? "").trim())
        .filter(v => v !== "")
        .sort((a, b) => Number(a) - Number(b))
        .join(", ");

      entries.push({
        order: toOrder(rows[survivorIdx][cOrig]),
        row: [...record, mergedFrom]
      });

      for (const idx of members) {
        inMergedGroup.add(idx);
      }

      householdsMerged++;
      accountsCombined += members.length;
    });

    // Rows that weren't merged stay as they are.
    for (const idx of indexes) {
      if (inMergedGroup.has(idx)) {
        continue;
      }

      entries.push({
        order: toOrder(rows[idx][cOrig]),
        row: [...rows[idx].slice(0, originalColumnCount), ""]
      });
    }

    entries.sort((a, b) => a.order - b.order);

    groupOutputs.push({
      sortKey: entries[0].order,
      entries: entries
    });
  });

  groupOutputs.sort((a, b) => a.sortKey - b.sortKey);

  const outputRows: Cell[][] = [];

  for (const group of groupOutputs) {
    for (const entry of group.entries) {
      outputRows.push(entry.row);
    }
  }

  // ----------------------------------
  // CREATE TAB AND WRITE ROWS
  // ----------------------------------

  const duplicatesSheet = getOrCreateReviewSheet(
    workbook,
    DUPLICATE_ADDRESSES_SHEET,
    [...originalHeaders, MERGED_FROM_HEADER],
    DUPLICATES_TAB_COLOR
  );

  appendRows(duplicatesSheet, outputRows, originalColumnCount + 1);

  // ----------------------------------
  // REWRITE DATA SHEET (only if rows moved)
  // ----------------------------------

  const kept: Cell[][] = rows.filter((_, index) => !movedIndexes.has(index));

  if (movedIndexes.size > 0) {
    // Clear contents only, so header styling and number formats stay.
    used.clear(ExcelScript.ClearApplyTo.contents);

    const rebuilt: Cell[][] = [headers, ...kept];

    dataSheet
      .getRangeByIndexes(0, 0, rebuilt.length, headers.length)
      .setValues(rebuilt);
  }

  console.log(
    `PHASE 8 COMPLETE

Shared addresses found: ${addressGroupCount}
Rows moved off the main sheet: ${movedIndexes.size}
Households merged: ${householdsMerged}
  (accounts combined into them: ${accountsCombined})
Rows written to ${DUPLICATE_ADDRESSES_SHEET}: ${outputRows.length}

Remaining rows on main sheet: ${kept.length}`
  );
}
