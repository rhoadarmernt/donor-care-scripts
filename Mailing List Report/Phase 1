/**
 * PHASE 1 - SETUP & FOUNDATION
 * Mid/Major List Cleanup
 *
 * Run this ONCE with the donor data worksheet active.
 *
 * What it does:
 *   1. Validates required column headers
 *   2. Creates an untouched copy named "Raw Backup"
 *   3. Adds one helper column: Original Row (each row's position in
 *      the original data, so later phases can trace rows back)
 *   4. Fills in blank greetings from the Account Name:
 *        - Blank Formal Greeting   -> copied from Account Name
 *        - Blank Informal Greeting -> the Formal Greeting without its
 *          last name ("John Smith" -> "John",
 *          "Matthew and Patricia Jones" -> "Matthew and Patricia")
 *      If the name doesn't look like a person (LLC, Trust, Household,
 *      Family, etc.) the Informal Greeting is the full name instead.
 *      Greetings that already have a value are never changed.
 *   5. Creates a "Blank Addresses" sheet for rows removed later
 *      (Phase 2) because Billing Street is empty
 *
 * Original Row numbers match each row's position in Raw Backup.
 * No rows are moved or deleted in this phase.
 */

type Cell = string | number | boolean;

// --------------------------------------------------
// SETTINGS
// --------------------------------------------------

const REQUIRED_HEADERS: string[] = [
  "Last Activity",
  "Account Name",
  "Formal Greeting",
  "Informal Greeting",
  "Billing Street",
  "Billing City",
  "Billing Zip/Postal Code",
  "Billing State/Province",
  "Billing Country",
  "Type",
  "Last Modified Date",
  "Account Case Safe ID",
  "Primary Household ID",
  "Average Gift"
];

const HELPER_HEADERS: string[] = [
  "Original Row"
];

const BACKUP_SHEET = "Raw Backup";
const BLANK_ADDRESSES_SHEET = "Blank Addresses";

// Ignored when working out the last name (John Smith Jr. -> Smith).
const NAME_SUFFIXES: string[] = [
  "JR", "SR", "II", "III", "IV", "MD", "PHD", "ESQ"
];

// If the last word is one of these, the name isn't a person's, so
// the Informal Greeting is the full name rather than "first names".
const NON_PERSON_WORDS: string[] = [
  "LLC", "INC", "CORP", "LLP", "LP", "TRUST", "FOUNDATION",
  "ESTATE", "COMPANY", "FAMILY", "HOUSEHOLD", "FUND"
];

const HEADER_COLOR = "#D9E1F2";
const BACKUP_TAB_COLOR = "#808080";
const BLANK_ADDRESSES_TAB_COLOR = "#FF6666";

const CHUNK_SIZE = 500;

// --------------------------------------------------
// HELPERS
// --------------------------------------------------

function styleHeader(range: ExcelScript.Range): void {
  const format = range.getFormat();

  format.getFont().setBold(true);
  format.getFill().setColor(HEADER_COLOR);
}

function writeHeader(
  sheet: ExcelScript.Worksheet,
  headers: string[]
): void {
  const headerRange = sheet.getRangeByIndexes(
    0,
    0,
    1,
    headers.length
  );

  headerRange.setValues([headers]);
  styleHeader(headerRange);
  sheet.getFreezePanes().freezeRows(1);
}

function cleanText(value: Cell): string {
  return String(value ?? "")
    .replace(/[\u200B\uFEFF]/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

function isBlank(value: Cell): boolean {
  return cleanText(value) === "";
}

function stripPunctuation(word: string): string {
  return word.replace(/[.,;:]+$/g, "");
}

/**
 * "John Smith" -> "John"
 * "Matthew and Patricia Jones" -> "Matthew and Patricia"
 * "Acme LLC" / "Smith Household" -> unchanged (not a person's name)
 */
function deriveInformalGreeting(formal: string): string {
  const full = cleanText(formal);
  const words = full.split(" ");

  // Drop suffixes like Jr. or III before finding the last name.
  while (
    words.length > 1 &&
    NAME_SUFFIXES.includes(
      stripPunctuation(words[words.length - 1]).toUpperCase()
    )
  ) {
    words.pop();
  }

  if (words.length < 2) {
    return full;
  }

  const lastWord = stripPunctuation(
    words[words.length - 1]
  ).toUpperCase();

  if (NON_PERSON_WORDS.includes(lastWord)) {
    return full;
  }

  words.pop();

  return words.join(" ");
}

function writeRowsInChunks(
  sheet: ExcelScript.Worksheet,
  startRow: number,
  startColumn: number,
  rows: Cell[][],
  columnCount: number
): void {
  for (let offset = 0; offset < rows.length; offset += CHUNK_SIZE) {
    const chunk = rows.slice(offset, offset + CHUNK_SIZE);

    sheet
      .getRangeByIndexes(
        startRow + offset,
        startColumn,
        chunk.length,
        columnCount
      )
      .setValues(chunk);

    // Reading a value forces Excel to process this chunk now,
    // so the writes don't pile up into one oversized request.
    sheet.getRange("A1").getValue();
  }
}

// --------------------------------------------------
// MAIN
// --------------------------------------------------

function main(workbook: ExcelScript.Workbook): void {
  const dataSheet = workbook.getActiveWorksheet();
  const usedRange = dataSheet.getUsedRange();

  if (!usedRange) {
    throw new Error(
      "The active sheet is empty. Activate the donor data worksheet and run the script again."
    );
  }

  // Headers must begin at A1.
  if (
    usedRange.getRowIndex() !== 0 ||
    usedRange.getColumnIndex() !== 0
  ) {
    throw new Error(
      "Headers must begin in cell A1, with no blank rows above them or blank columns to their left."
    );
  }

  // Raw Backup is the marker that Phase 1 has already run.
  if (workbook.getWorksheet(BACKUP_SHEET)) {
    throw new Error(
      `A worksheet named "${BACKUP_SHEET}" already exists. Phase 1 has probably already been run.`
    );
  }

  const values = usedRange.getValues() as Cell[][];
  const rowCount = usedRange.getRowCount();
  const columnCount = usedRange.getColumnCount();

  const headers = values[0].map(value =>
    String(value).trim()
  );

  // --------------------------------------------------
  // VALIDATE REQUIRED HEADERS
  // --------------------------------------------------

  const missingHeaders = REQUIRED_HEADERS.filter(
    requiredHeader => !headers.includes(requiredHeader)
  );

  if (missingHeaders.length > 0) {
    throw new Error(
      `Missing or misspelled header(s): ${missingHeaders.join(", ")}`
    );
  }

  // --------------------------------------------------
  // RAW BACKUP
  // --------------------------------------------------

  // This happens before anything is changed, so the backup remains
  // an untouched copy of the original data worksheet (including any
  // blank greetings).
  const backupSheet = dataSheet.copy(
    ExcelScript.WorksheetPositionType.end
  );

  backupSheet.setName(BACKUP_SHEET);
  backupSheet.setTabColor(BACKUP_TAB_COLOR);

  dataSheet.activate();

  // --------------------------------------------------
  // ADD HELPER COLUMN (Original Row)
  // --------------------------------------------------

  // Header = row 1, so the first data row is 2.
  // These match Raw Backup positions.
  const helpersToAdd = HELPER_HEADERS.filter(
    helperHeader => !headers.includes(helperHeader)
  );

  if (helpersToAdd.length > 0) {
    writeHeader(
      dataSheet,
      [...headers, ...helpersToAdd]
    );

    const helperValues: Cell[][] = Array.from(
      { length: rowCount - 1 },
      (_, index) => [index + 2]
    );

    writeRowsInChunks(
      dataSheet,
      1,
      columnCount,
      helperValues,
      helpersToAdd.length
    );
  }

  // --------------------------------------------------
  // FILL BLANK GREETINGS FROM ACCOUNT NAME
  // --------------------------------------------------

  const cAccount = headers.indexOf("Account Name");
  const cFormal = headers.indexOf("Formal Greeting");
  const cInformal = headers.indexOf("Informal Greeting");

  const formalColumn: Cell[][] = [];
  const informalColumn: Cell[][] = [];

  let formalFilled = 0;
  let informalFilled = 0;
  let rowsStillBlank = 0;

  for (let i = 1; i < values.length; i++) {
    const row = values[i];

    let formal = row[cFormal];
    let informal = row[cInformal];

    // Blank Formal Greeting -> copy the Account Name
    if (isBlank(formal) && !isBlank(row[cAccount])) {
      formal = cleanText(row[cAccount]);
      formalFilled++;
    }

    // Blank Informal Greeting -> derive from the Formal Greeting
    if (isBlank(informal) && !isBlank(formal)) {
      informal = deriveInformalGreeting(String(formal));
      informalFilled++;
    }

    formalColumn.push([formal]);
    informalColumn.push([informal]);

    if (
      isBlank(row[cAccount]) ||
      isBlank(formal) ||
      isBlank(informal)
    ) {
      rowsStillBlank++;
    }
  }

  // Only write a column if something in it changed.
  if (formalFilled > 0) {
    writeRowsInChunks(dataSheet, 1, cFormal, formalColumn, 1);
  }

  if (informalFilled > 0) {
    writeRowsInChunks(dataSheet, 1, cInformal, informalColumn, 1);
  }

  // --------------------------------------------------
  // BLANK ADDRESSES (empty sheet, filled by Phase 2)
  // --------------------------------------------------

  let blankAddressesSheet = workbook.getWorksheet(BLANK_ADDRESSES_SHEET);

  if (!blankAddressesSheet) {
    blankAddressesSheet = workbook.addWorksheet(BLANK_ADDRESSES_SHEET);

    // Same headers as the donor data sheet, in the same order,
    // so removed rows can be pasted in as-is.
    writeHeader(blankAddressesSheet, headers);

    blankAddressesSheet.setTabColor(BLANK_ADDRESSES_TAB_COLOR);
  }

  dataSheet.getFreezePanes().freezeRows(1);

  // --------------------------------------------------
  // COSMETIC FORMATTING
  // --------------------------------------------------

  try {
    dataSheet
      .getRangeByIndexes(
        0,
        0,
        1,
        columnCount + helpersToAdd.length
      )
      .getFormat()
      .autofitColumns();
  } catch {
    console.log("Skipped autofit. This does not affect the data.");
  }

  // --------------------------------------------------
  // COMPLETION MESSAGE
  // --------------------------------------------------

  const helperMessage =
    helpersToAdd.length > 0
      ? helpersToAdd.join(", ")
      : "None (already present)";

  console.log(
    `PHASE 1 COMPLETE

Rows found: ${rowCount - 1}

Backup created:
${BACKUP_SHEET}

Helper column added:
${helperMessage}

Blank Formal Greetings filled: ${formalFilled}
Blank Informal Greetings filled: ${informalFilled}
Rows still missing a name or greeting: ${rowsStillBlank}

Additional sheet prepared:
${BLANK_ADDRESSES_SHEET}`
  );
}
