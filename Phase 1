/**
 * PHASE 1 - SETUP & FOUNDATION
 * Mid/Major List Cleanup
 *
 * Run this ONCE with the donor data worksheet active.
 *
 * What it does:
 *   1. Validates required column headers
 *   2. Creates an untouched copy named "Raw Backup"
 *   3. Adds missing helper columns:
 *        - Original Row
 *        - Flag
 *        - Flag Reason
 *        - Suggested Fix
 *   4. Creates:
 *        - Changes Log
 *        - Summary
 *        - Deleted Rows
 *
 * It does not modify existing donor data.
 */

type Cell = string | number | boolean;

// --------------------------------------------------
// SETTINGS
// --------------------------------------------------

const REQUIRED_HEADERS: string[] = [
  "Last Activity",
  "Account Name",
  "Formal Greeting",
  "Informal Greeting",
  "Billing Street",
  "Billing City",
  "Billing Zip/Postal Code",
  "Billing State/Province",
  "Billing Country",
  "Type",
  "Last Modified Date",
  "Account Case Safe ID",
  "Primary Household ID",
  "Average Gift"
];

const HELPER_HEADERS: string[] = [
  "Original Row",
  "Flag",
  "Flag Reason",
  "Suggested Fix"
];

const LOG_HEADERS: string[] = [
  "Original Row",
  "Account Case Safe ID",
  "Column",
  "Original Value",
  "New Value",
  "Rule Triggered",
  "Action",
  "Timestamp"
];

const BACKUP_SHEET = "Raw Backup";
const LOG_SHEET = "Changes Log";
const SUMMARY_SHEET = "Summary";
const DELETED_SHEET = "Deleted Rows";

const HEADER_COLOR = "#D9E1F2";
const BACKUP_TAB_COLOR = "#808080";
const DELETED_TAB_COLOR = "#FF6666";

// --------------------------------------------------
// HELPERS
// --------------------------------------------------

function formatTimestamp(date: Date = new Date()): string {
  const yyyy = date.getFullYear();
  const mm = String(date.getMonth() + 1).padStart(2, "0");
  const dd = String(date.getDate()).padStart(2, "0");
  const hh = String(date.getHours()).padStart(2, "0");
  const min = String(date.getMinutes()).padStart(2, "0");

  return `${yyyy}-${mm}-${dd} ${hh}:${min}`;
}

function styleHeader(range: ExcelScript.Range): void {
  const format = range.getFormat();

  format.getFont().setBold(true);
  format.getFill().setColor(HEADER_COLOR);
}

function writeHeader(
  sheet: ExcelScript.Worksheet,
  headers: string[]
): void {
  const headerRange = sheet.getRangeByIndexes(
    0,
    0,
    1,
    headers.length
  );

  headerRange.setValues([headers]);
  styleHeader(headerRange);
  sheet.getFreezePanes().freezeRows(1);
}

function appendRows(
  sheet: ExcelScript.Worksheet,
  rows: Cell[][],
  columnCount: number
): void {
  if (rows.length === 0) {
    return;
  }

  const usedRange = sheet.getUsedRange();
  const nextRow = usedRange ? usedRange.getRowCount() : 0;

  sheet
    .getRangeByIndexes(
      nextRow,
      0,
      rows.length,
      columnCount
    )
    .setValues(rows);
}

// --------------------------------------------------
// MAIN
// --------------------------------------------------

function main(workbook: ExcelScript.Workbook): void {
  const dataSheet = workbook.getActiveWorksheet();
  const usedRange = dataSheet.getUsedRange();

  if (!usedRange) {
    throw new Error(
      "The active sheet is empty. Activate the donor data worksheet and run the script again."
    );
  }

  // Headers must begin at A1.
  if (
    usedRange.getRowIndex() !== 0 ||
    usedRange.getColumnIndex() !== 0
  ) {
    throw new Error(
      "Headers must begin in cell A1, with no blank rows above them or blank columns to their left."
    );
  }

  // Raw Backup is the marker that Phase 1 has already run.
  if (workbook.getWorksheet(BACKUP_SHEET)) {
    throw new Error(
      `A worksheet named "${BACKUP_SHEET}" already exists. Phase 1 has probably already been run.`
    );
  }

  const values = usedRange.getValues();
  const rowCount = usedRange.getRowCount();
  const columnCount = usedRange.getColumnCount();
  const timestamp = formatTimestamp();

  const headers = values[0].map(value =>
    String(value).trim()
  );

  // --------------------------------------------------
  // VALIDATE REQUIRED HEADERS
  // --------------------------------------------------

  const missingHeaders = REQUIRED_HEADERS.filter(
    requiredHeader => !headers.includes(requiredHeader)
  );

  if (missingHeaders.length > 0) {
    throw new Error(
      `Missing or misspelled header(s): ${missingHeaders.join(", ")}`
    );
  }

  // --------------------------------------------------
  // RAW BACKUP
  // --------------------------------------------------

  // This happens before helper columns are added, so the backup
  // remains an untouched copy of the original data worksheet.
  const backupSheet = dataSheet.copy(
    ExcelScript.WorksheetPositionType.end
  );

  backupSheet.setName(BACKUP_SHEET);
  backupSheet.setTabColor(BACKUP_TAB_COLOR);

  dataSheet.activate();

  // --------------------------------------------------
  // ADD HELPER COLUMNS
  // --------------------------------------------------

  const helpersToAdd = HELPER_HEADERS.filter(
    helperHeader => !headers.includes(helperHeader)
  );

  if (helpersToAdd.length > 0) {
    const helperValues: Cell[][] = [
      helpersToAdd,
      ...Array.from(
        { length: rowCount - 1 },
        (_, index) =>
          helpersToAdd.map(header =>
            header === "Original Row"
              ? index + 2
              : ""
          )
      )
    ];

    const helperRange = dataSheet.getRangeByIndexes(
      0,
      columnCount,
      rowCount,
      helpersToAdd.length
    );

    helperRange.setValues(helperValues);

    styleHeader(
      dataSheet.getRangeByIndexes(
        0,
        columnCount,
        1,
        helpersToAdd.length
      )
    );
  }

  dataSheet.getFreezePanes().freezeRows(1);

  // --------------------------------------------------
  // CHANGES LOG
  // --------------------------------------------------

  let logSheet = workbook.getWorksheet(LOG_SHEET);

  if (!logSheet) {
    logSheet = workbook.addWorksheet(LOG_SHEET);
    writeHeader(logSheet, LOG_HEADERS);
  }

  appendRows(
    logSheet,
    [[
      "-",
      "-",
      "-",
      "-",
      "-",
      "Phase 1 setup complete",
      "Setup",
      timestamp
    ]],
    LOG_HEADERS.length
  );

  // --------------------------------------------------
  // SUMMARY
  // --------------------------------------------------

  let summarySheet = workbook.getWorksheet(SUMMARY_SHEET);

  if (!summarySheet) {
    summarySheet = workbook.addWorksheet(SUMMARY_SHEET);

    writeHeader(summarySheet, ["Metric", "Count"]);

    summarySheet
      .getRangeByIndexes(1, 0, 2, 2)
      .setValues([
        [
          "Data rows at start (excluding header)",
          rowCount - 1
        ],
        [
          "Setup run",
          timestamp
        ]
      ]);

    summarySheet
      .getRange("A:A")
      .getFormat()
      .setColumnWidth(260);

    summarySheet
      .getRange("B:B")
      .getFormat()
      .setColumnWidth(180);
  }

  // --------------------------------------------------
  // DELETED ROWS
  // --------------------------------------------------

  let deletedSheet = workbook.getWorksheet(DELETED_SHEET);

  if (!deletedSheet) {
    deletedSheet = workbook.addWorksheet(DELETED_SHEET);

    writeHeader(
      deletedSheet,
      [
        "Deleted Reason",
        "Deleted Timestamp",
        ...headers
      ]
    );

    deletedSheet.setTabColor(DELETED_TAB_COLOR);
  }

  // --------------------------------------------------
  // COSMETIC FORMATTING
  // --------------------------------------------------

  try {
    dataSheet
      .getRangeByIndexes(
        0,
        0,
        1,
        columnCount + helpersToAdd.length
      )
      .getFormat()
      .autofitColumns();

    logSheet
      .getRangeByIndexes(
        0,
        0,
        1,
        LOG_HEADERS.length
      )
      .getFormat()
      .autofitColumns();
  } catch {
    console.log("Skipped autofit. This does not affect the data.");
  }

  // --------------------------------------------------
  // COMPLETION MESSAGE
  // --------------------------------------------------

  const helperMessage =
    helpersToAdd.length > 0
      ? helpersToAdd.join(", ")
      : "None (already present)";

  console.log(
    `PHASE 1 COMPLETE

Rows found: ${rowCount - 1}

Backup created:
${BACKUP_SHEET}

Helper columns added:
${helperMessage}

Additional sheets prepared:
${LOG_SHEET}
${SUMMARY_SHEET}
${DELETED_SHEET}`
  );
}
