/**
 * PHASE 1 - SETUP & FOUNDATION
 * Mid/Major List Cleanup (Office Scripts)
 *
 * Run this ONCE, with your data sheet as the active sheet.
 *
 * What it does:
 *   1. Checks that all expected column headers exist
 *   2. Saves an untouched copy of the data to "Raw Backup"
 *   3. Adds helper columns:
 *        - Original Row
 *        - Flag
 *        - Flag Reason
 *        - Suggested Fix
 *   4. Creates:
 *        - Changes Log
 *        - Summary
 *        - Deleted Rows
 *
 * It does NOT modify donor data.
 */

type Cell = string | number | boolean;

// --------------------------------------------------
// SETTINGS
// --------------------------------------------------

const REQUIRED_HEADERS: string[] = [
  "Last Activity",
  "Account Name",
  "Formal Greeting",
  "Informal Greeting",
  "Billing Street",
  "Billing City",
  "Billing Zip/Postal Code",
  "Billing State/Province",
  "Billing Country",
  "Type",
  "Last Modified Date",
  "Account Case Safe ID",
  "Primary Household ID",
  "Average Gift"
];

const HELPER_HEADERS: string[] = [
  "Original Row",
  "Flag",
  "Flag Reason",
  "Suggested Fix"
];

const LOG_HEADERS: string[] = [
  "Original Row",
  "Account Case Safe ID",
  "Column",
  "Original Value",
  "New Value",
  "Rule Triggered",
  "Action",
  "Timestamp"
];

const BACKUP_SHEET = "Raw Backup";
const LOG_SHEET = "Changes Log";
const SUMMARY_SHEET = "Summary";
const DELETED_SHEET = "Deleted Rows";

// --------------------------------------------------
// HELPERS
// --------------------------------------------------

function formatTimestamp(): string {

  const d = new Date();

  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  const dd = String(d.getDate()).padStart(2, "0");

  const hh = String(d.getHours()).padStart(2, "0");
  const min = String(d.getMinutes()).padStart(2, "0");

  return `${yyyy}-${mm}-${dd} ${hh}:${min}`;
}

function appendLog(
  log: ExcelScript.Worksheet,
  entries: Cell[][]
): void {

  if (entries.length === 0) {
    return;
  }

  const nextRow =
    log.getUsedRange().getRowCount();

  log
    .getRangeByIndexes(
      nextRow,
      0,
      entries.length,
      LOG_HEADERS.length
    )
    .setValues(entries);
}

function logRow(
  originalRow: number | string,
  accountId: Cell,
  column: string,
  oldValue: Cell,
  newValue: Cell,
  rule: string,
  action: string
): Cell[] {

  return [
    originalRow,
    accountId,
    column,
    oldValue,
    newValue,
    rule,
    action,
    formatTimestamp()
  ];
}

function colIndex(
  headers: string[],
  name: string
): number {

  const idx = headers.indexOf(name);

  if (idx === -1) {
    throw new Error(
      `Column not found: "${name}"`
    );
  }

  return idx;
}

function styleHeader(
  range: ExcelScript.Range
): void {

  range
    .getFormat()
    .getFont()
    .setBold(true);

  range
    .getFormat()
    .getFill()
    .setColor("#D9E1F2");
}

// --------------------------------------------------
// MAIN
// --------------------------------------------------

function main(
  workbook: ExcelScript.Workbook
) {

  const dataSheet =
    workbook.getActiveWorksheet();

  const used =
    dataSheet.getUsedRange();

  if (!used) {

    throw new Error(
      "The active sheet is empty. Activate your donor data worksheet and run again."
    );
  }

  // Headers must start in A1

  if (
    used.getRowIndex() !== 0 ||
    used.getColumnIndex() !== 0
  ) {

    throw new Error(
      "Headers must start in cell A1 with no blank rows or columns above or to the left."
    );
  }

  // Prevent accidental second run

  if (
    workbook.getWorksheet(
      BACKUP_SHEET
    )
  ) {

    throw new Error(
      `A sheet named "${BACKUP_SHEET}" already exists. Setup has probably already been run.`
    );
  }

  const values =
    used.getValues();

  const rowCount =
    used.getRowCount();

  const colCount =
    used.getColumnCount();

  const headers: string[] =
    values[0].map(
      h => String(h).trim()
    );

  // --------------------------------------------------
  // VALIDATE REQUIRED HEADERS
  // --------------------------------------------------

  const missing =
    REQUIRED_HEADERS.filter(
      h => headers.indexOf(h) === -1
    );

  if (missing.length > 0) {

    throw new Error(
      `Missing or misspelled header(s): ${missing.join(", ")}`
    );
  }

  // --------------------------------------------------
  // RAW BACKUP
  // --------------------------------------------------

  const backup =
    dataSheet.copy(
      ExcelScript.WorksheetPositionType.end
    );

  backup.setName(
    BACKUP_SHEET
  );

  backup.setTabColor(
    "#808080"
  );

  dataSheet.activate();

  // --------------------------------------------------
  // ADD HELPER COLUMNS
  // --------------------------------------------------

  const toAdd =
    HELPER_HEADERS.filter(
      h => headers.indexOf(h) === -1
    );

  if (toAdd.length > 0) {

    const helperData: Cell[][] = [];

    helperData.push(
      toAdd.slice()
    );

    for (
      let r = 1;
      r < rowCount;
      r++
    ) {

      const row: Cell[] = [];

      for (const h of toAdd) {

        row.push(
          h === "Original Row"
            ? r + 1
            : ""
        );
      }

      helperData.push(row);
    }

    dataSheet
      .getRangeByIndexes(
        0,
        colCount,
        rowCount,
        toAdd.length
      )
      .setValues(helperData);

    styleHeader(
      dataSheet.getRangeByIndexes(
        0,
        colCount,
        1,
        toAdd.length
      )
    );
  }

  dataSheet
    .getFreezePanes()
    .freezeRows(1);

  // --------------------------------------------------
  // CHANGES LOG
  // --------------------------------------------------

  let log =
    workbook.getWorksheet(
      LOG_SHEET
    );

  if (!log) {

    log =
      workbook.addWorksheet(
        LOG_SHEET
      );

    const logHeader =
      log.getRangeByIndexes(
        0,
        0,
        1,
        LOG_HEADERS.length
      );

    logHeader.setValues([
      LOG_HEADERS
    ]);

    styleHeader(
      logHeader
    );

    log
      .getFreezePanes()
      .freezeRows(1);
  }

  appendLog(
    log,
    [
      logRow(
        "-",
        "-",
        "-",
        "-",
        "-",
        "Phase 1 setup complete",
        "Setup"
      )
    ]
  );

  // --------------------------------------------------
  // SUMMARY
  // --------------------------------------------------

  let summary =
    workbook.getWorksheet(
      SUMMARY_SHEET
    );

  if (!summary) {

    summary =
      workbook.addWorksheet(
        SUMMARY_SHEET
      );

    const summaryHeader =
      summary.getRangeByIndexes(
        0,
        0,
        1,
        2
      );

    summaryHeader.setValues([
      ["Metric", "Count"]
    ]);

    styleHeader(
      summaryHeader
    );

    summary
      .getRangeByIndexes(
        1,
        0,
        2,
        2
      )
      .setValues([
        [
          "Data rows at start (excluding header)",
          rowCount - 1
        ],
        [
          "Setup run",
          formatTimestamp()
        ]
      ]);

    summary
      .getRange("A:A")
      .getFormat()
      .setColumnWidth(260);

    summary
      .getRange("B:B")
      .getFormat()
      .setColumnWidth(180);
  }

  // --------------------------------------------------
  // DELETED ROWS
  // --------------------------------------------------

  let deleted =
    workbook.getWorksheet(
      DELETED_SHEET
    );

  if (!deleted) {

    deleted =
      workbook.addWorksheet(
        DELETED_SHEET
      );

    const deletedHeaders = [
      "Deleted Reason",
      "Deleted Timestamp",
      ...headers
    ];

    const deletedHeaderRange =
      deleted.getRangeByIndexes(
        0,
        0,
        1,
        deletedHeaders.length
      );

    deletedHeaderRange.setValues([
      deletedHeaders
    ]);

    styleHeader(
      deletedHeaderRange
    );

    deleted
      .getFreezePanes()
      .freezeRows(1);

    deleted.setTabColor(
      "#FF6666"
    );
  }

  // --------------------------------------------------
  // COSMETICS
  // --------------------------------------------------

  try {

    dataSheet
      .getRangeByIndexes(
        0,
        0,
        1,
        colCount + toAdd.length
      )
      .getFormat()
      .autofitColumns();

    log
      .getRangeByIndexes(
        0,
        0,
        1,
        LOG_HEADERS.length
      )
      .getFormat()
      .autofitColumns();

  } catch {

    console.log(
      "Skipped autofit (cosmetic only)."
    );
  }

  console.log(
    `PHASE 1 COMPLETE

Rows found: ${rowCount - 1}

Backup created:
${BACKUP_SHEET}

Helper columns added:
${toAdd.length > 0
      ? toAdd.join(", ")
      : "None (already present)"}

Additional sheets created:
${LOG_SHEET}
${SUMMARY_SHEET}
${DELETED_SHEET}`
  );
}
