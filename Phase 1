/**
 * PHASE 1 - SETUP & FOUNDATION
 * Mid/Major List Cleanup
 *
 * Run this ONCE with the donor data worksheet active.
 *
 * What it does:
 *   1. Validates required column headers
 *   2. Creates an untouched copy named "Raw Backup"
 *   3. Adds missing helper columns:
 *        - Original Row
 *        - Flag
 *        - Flag Reason
 *        - Suggested Fix
 *   4. Creates a "Blank Addresses" sheet for rows removed
 *      because Billing Street is empty
 *
 * It does not modify existing donor data.
 */

type Cell = string | number | boolean;

// --------------------------------------------------
// SETTINGS
// --------------------------------------------------

const REQUIRED_HEADERS: string[] = [
  "Last Activity",
  "Account Name",
  "Formal Greeting",
  "Informal Greeting",
  "Billing Street",
  "Billing City",
  "Billing Zip/Postal Code",
  "Billing State/Province",
  "Billing Country",
  "Type",
  "Last Modified Date",
  "Account Case Safe ID",
  "Primary Household ID",
  "Average Gift"
];

const HELPER_HEADERS: string[] = [
  "Original Row",
  "Flag",
  "Flag Reason",
  "Suggested Fix"
];

const BACKUP_SHEET = "Raw Backup";
const BLANK_ADDRESSES_SHEET = "Blank Addresses";

const HEADER_COLOR = "#D9E1F2";
const BACKUP_TAB_COLOR = "#808080";
const BLANK_ADDRESSES_TAB_COLOR = "#FF6666";

// --------------------------------------------------
// HELPERS
// --------------------------------------------------

function styleHeader(range: ExcelScript.Range): void {
  const format = range.getFormat();

  format.getFont().setBold(true);
  format.getFill().setColor(HEADER_COLOR);
}

function writeHeader(
  sheet: ExcelScript.Worksheet,
  headers: string[]
): void {
  const headerRange = sheet.getRangeByIndexes(
    0,
    0,
    1,
    headers.length
  );

  headerRange.setValues([headers]);
  styleHeader(headerRange);
  sheet.getFreezePanes().freezeRows(1);
}

// --------------------------------------------------
// MAIN
// --------------------------------------------------

function main(workbook: ExcelScript.Workbook): void {
  const dataSheet = workbook.getActiveWorksheet();
  const usedRange = dataSheet.getUsedRange();

  if (!usedRange) {
    throw new Error(
      "The active sheet is empty. Activate the donor data worksheet and run the script again."
    );
  }

  // Headers must begin at A1.
  if (
    usedRange.getRowIndex() !== 0 ||
    usedRange.getColumnIndex() !== 0
  ) {
    throw new Error(
      "Headers must begin in cell A1, with no blank rows above them or blank columns to their left."
    );
  }

  // Raw Backup is the marker that Phase 1 has already run.
  if (workbook.getWorksheet(BACKUP_SHEET)) {
    throw new Error(
      `A worksheet named "${BACKUP_SHEET}" already exists. Phase 1 has probably already been run.`
    );
  }

  const values = usedRange.getValues();
  const rowCount = usedRange.getRowCount();
  const columnCount = usedRange.getColumnCount();

  const headers = values[0].map(value =>
    String(value).trim()
  );

  // --------------------------------------------------
  // VALIDATE REQUIRED HEADERS
  // --------------------------------------------------

  const missingHeaders = REQUIRED_HEADERS.filter(
    requiredHeader => !headers.includes(requiredHeader)
  );

  if (missingHeaders.length > 0) {
    throw new Error(
      `Missing or misspelled header(s): ${missingHeaders.join(", ")}`
    );
  }

  // --------------------------------------------------
  // RAW BACKUP
  // --------------------------------------------------

  // This happens before helper columns are added, so the backup
  // remains an untouched copy of the original data worksheet.
  const backupSheet = dataSheet.copy(
    ExcelScript.WorksheetPositionType.end
  );

  backupSheet.setName(BACKUP_SHEET);
  backupSheet.setTabColor(BACKUP_TAB_COLOR);

  dataSheet.activate();

  // --------------------------------------------------
  // ADD HELPER COLUMNS
  // --------------------------------------------------

  const helpersToAdd = HELPER_HEADERS.filter(
    helperHeader => !headers.includes(helperHeader)
  );

  if (helpersToAdd.length > 0) {
    const helperValues: Cell[][] = [
      helpersToAdd,
      ...Array.from(
        { length: rowCount - 1 },
        (_, index) =>
          helpersToAdd.map(header =>
            header === "Original Row"
              ? index + 2
              : ""
          )
      )
    ];

    const helperRange = dataSheet.getRangeByIndexes(
      0,
      columnCount,
      rowCount,
      helpersToAdd.length
    );

    helperRange.setValues(helperValues);

    styleHeader(
      dataSheet.getRangeByIndexes(
        0,
        columnCount,
        1,
        helpersToAdd.length
      )
    );
  }

  dataSheet.getFreezePanes().freezeRows(1);

  // --------------------------------------------------
  // BLANK ADDRESSES
  // --------------------------------------------------

  let blankSheet = workbook.getWorksheet(BLANK_ADDRESSES_SHEET);

  if (!blankSheet) {
    blankSheet = workbook.addWorksheet(BLANK_ADDRESSES_SHEET);

    // Same headers as the donor data sheet, in the same order,
    // so removed rows can be pasted in as-is.
    writeHeader(blankSheet, headers);

    blankSheet.setTabColor(BLANK_ADDRESSES_TAB_COLOR);
  }

  // --------------------------------------------------
  // COSMETIC FORMATTING
  // --------------------------------------------------

  try {
    dataSheet
      .getRangeByIndexes(
        0,
        0,
        1,
        columnCount + helpersToAdd.length
      )
      .getFormat()
      .autofitColumns();
  } catch {
    console.log("Skipped autofit. This does not affect the data.");
  }

  // --------------------------------------------------
  // COMPLETION MESSAGE
  // --------------------------------------------------

  const helperMessage =
    helpersToAdd.length > 0
      ? helpersToAdd.join(", ")
      : "None (already present)";

  console.log(
    `PHASE 1 COMPLETE

Rows found: ${rowCount - 1}

Backup created:
${BACKUP_SHEET}

Helper columns added:
${helperMessage}

Additional sheet prepared:
${BLANK_ADDRESSES_SHEET}`
  );
}
