function main(workbook: ExcelScript.Workbook) {
    // ==========================
    // EDIT THESE HEADERS AS NEEDED
    // ==========================
    const EMAIL_HEADER = "Email";
    const NAME_HEADER = "Full Name";
    const AMOUNT_HEADER = "Net Amount";

    // ==========================
    // DO NOT EDIT BELOW
    // ==========================
    const sheet = workbook.getActiveWorksheet();
    const usedRange = sheet.getUsedRange(true);
    if (!usedRange) return;

    // Auto-fit columns to content
    usedRange.getFormat().autofitColumns();

    const headers = usedRange.getValues()[0] as string[];
    const colCount = headers.length;

    const emailCol = headers.indexOf(EMAIL_HEADER);
    const nameCol = headers.indexOf(NAME_HEADER);
    const amountCol = headers.indexOf(AMOUNT_HEADER);

    if (emailCol === -1) throw new Error(`Header not found: ${EMAIL_HEADER}`);
    if (nameCol === -1) throw new Error(`Header not found: ${NAME_HEADER}`);
    if (amountCol === -1) throw new Error(`Header not found: ${AMOUNT_HEADER}`);

    const rowCount = usedRange.getRowCount();

    // Sort by email
    if (rowCount > 1) {
        sheet.getRangeByIndexes(1, 0, rowCount - 1, colCount)
            .getSort()
            .apply([{ key: emailCol, ascending: true }], false);
    }

    const toProperCase = (text: string) =>
        text.toLowerCase().replace(/\b\w/g, c => c.toUpperCase());

    // Re-read after sort, and standardize name/email formatting in memory
    // (no per-cell API calls — this gets written back in one batch below)
    const values = sheet.getUsedRange(true).getValues() as (string | number)[][];
    for (let r = 1; r < values.length; r++) {
        const name = String(values[r][nameCol] ?? "").trim();
        if (name) values[r][nameCol] = toProperCase(name);

        const email = String(values[r][emailCol] ?? "").trim();
        if (email) values[r][emailCol] = email.toLowerCase();
    }

    const output: (string | number)[][] = [];
    const hideRanges: string[] = [];
    let r = 1;

    while (r < values.length) {
        const email = String(values[r][emailCol] ?? "").trim();
        if (!email) { r++; continue; }

        const isAnonymous = email === "anonymous";
        const start = r;
        const names = new Set<string>();
        let totalAmount = 0;

        while (r < values.length && String(values[r][emailCol] ?? "").trim() === email) {
            const name = String(values[r][nameCol] ?? "").trim();
            if (name) names.add(name);
            totalAmount += Number(values[r][amountCol]) || 0;
            r++;
        }

        const groupSize = r - start;
        const shouldAggregate = groupSize > 1 && (isAnonymous || names.size <= 1);

        if (shouldAggregate) {
            const newRow: (string | number)[] = Array(colCount).fill("");
            newRow[emailCol] = email;
            newRow[amountCol] = totalAmount;
            if (!isAnonymous && names.size === 1) {
                newRow[nameCol] = Array.from(names)[0];
            }
            output.push(newRow);
            // Rows are contiguous post-sort, so hide the whole group as one range
            hideRanges.push(`A${start + 1}:A${r}`);
        }
    }

    // Write standardized data rows + append summary rows in a single call
    const combined = values.slice(1).concat(output);
    if (combined.length > 0) {
        sheet.getRangeByIndexes(1, 0, combined.length, colCount).setValues(combined);
    }

    // Hide source rows — one call per contiguous group instead of per row
    for (const range of hideRanges) {
        sheet.getRange(range).getEntireRow().setRowHidden(true);
    }

    // Hide unnecessary columns
    for (let c = 0; c < colCount; c++) {
        if (c !== emailCol && c !== nameCol && c !== amountCol) {
            sheet.getRangeByIndexes(0, c, combined.length + 1, 1)
                .getEntireColumn()
                .setColumnHidden(true);
        }
    }

    console.log(`Appended ${output.length} totals and hid ${hideRanges.length} source row group(s).`);
}
