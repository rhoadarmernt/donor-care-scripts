/**
 * PHASE 3 - STREET ADDRESS REVIEW
 *
 * Run this ONCE after Phase 2, with the donor data worksheet active.
 *
 * Moves rows out of the main sheet into review tabs:
 *   1. "One Word Address"     - Billing Street is exactly one word
 *   2. "City in Address"      - Billing Street contains the Billing City
 *   3. "Apt/Unit Duplicated"  - Billing Street has possible duplicate
 *                               Apt/Unit text
 *
 * A row that matches more than one check is copied to each matching
 * tab, but removed from the main sheet only once.
 *
 * Moved rows keep the original columns only (same layout as the
 * Blank Addresses sheet). Nothing else in the data is changed.
 */

type Cell = string | number | boolean;

// --------------------------------------------------
// SETTINGS
// --------------------------------------------------

const BACKUP_SHEET = "Raw Backup";
const BLANK_ADDRESSES_SHEET = "Blank Addresses";
const ONE_WORD_SHEET = "One Word Address";
const CITY_IN_ADDRESS_SHEET = "City in Address";
const APT_UNIT_SHEET = "Apt-Unit Duplicated";

const HEADER_COLOR = "#D9E1F2";
const REVIEW_TAB_COLOR = "#FFC000";

// --------------------------------------------------
// HELPERS
// --------------------------------------------------

function colIndex(headers: string[], name: string): number {
  const idx = headers.indexOf(name);

  if (idx === -1) {
    throw new Error(`Column not found: "${name}"`);
  }

  return idx;
}

function getOrCreateReviewSheet(
  workbook: ExcelScript.Workbook,
  name: string,
  headers: string[]
): ExcelScript.Worksheet {
  let sheet = workbook.getWorksheet(name);

  if (!sheet) {
    sheet = workbook.addWorksheet(name);

    const headerRange = sheet.getRangeByIndexes(0, 0, 1, headers.length);

    headerRange.setValues([headers]);
    headerRange.getFormat().getFont().setBold(true);
    headerRange.getFormat().getFill().setColor(HEADER_COLOR);

    sheet.getFreezePanes().freezeRows(1);
    sheet.setTabColor(REVIEW_TAB_COLOR);
  }

  return sheet;
}

function appendRows(
  sheet: ExcelScript.Worksheet,
  rows: Cell[][],
  columnCount: number
): void {
  if (rows.length === 0) {
    return;
  }

  const used = sheet.getUsedRange();
  const nextRow = used ? used.getRowCount() : 1;

  sheet
    .getRangeByIndexes(nextRow, 0, rows.length, columnCount)
    .setValues(rows);
}

function getWordCount(value: string): number {
  const trimmed = value.trim();

  return trimmed === "" ? 0 : trimmed.split(/\s+/).length;
}

/**
 * Normalizes text for city-name comparison.
 * "St. Louis" -> "st louis"
 */
function normalizeForComparison(value: string): string {
  return value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, " ")
    .trim()
    .replace(/\s+/g, " ");
}

/**
 * True when the full city name appears in the street as a complete
 * word or phrase ("York" will not match "Yorkshire").
 */
function streetContainsCity(street: string, city: string): boolean {
  const normalizedStreet = normalizeForComparison(street);
  const normalizedCity = normalizeForComparison(city);

  if (normalizedStreet === "" || normalizedCity === "") {
    return false;
  }

  return ` ${normalizedStreet} `.includes(` ${normalizedCity} `);
}

function hasDuplicateAptUnit(street: string): boolean {
  return (
    /\bapt\.?\s+\S+.*\bapt\.?\s+\S+/i.test(street) ||
    /\bunit\s+\S+.*\bunit\s+\S+/i.test(street)
  );
}

// --------------------------------------------------
// MAIN
// --------------------------------------------------

function main(workbook: ExcelScript.Workbook): void {
  const dataSheet = workbook.getActiveWorksheet();
  const sheetName = dataSheet.getName();

  if (
    [
      BACKUP_SHEET,
      BLANK_ADDRESSES_SHEET,
      ONE_WORD_SHEET,
      CITY_IN_ADDRESS_SHEET,
      APT_UNIT_SHEET
    ].includes(sheetName)
  ) {
    throw new Error("Activate the donor data sheet first.");
  }

  if (!workbook.getWorksheet(BACKUP_SHEET)) {
    throw new Error("Run Phase 1 first.");
  }

  const used = dataSheet.getUsedRange();

  if (!used) {
    throw new Error("No data found.");
  }

  const values = used.getValues() as Cell[][];

  if (values.length < 2) {
    throw new Error("The sheet needs headers and at least one data row.");
  }

  const headers = values[0].map(v => String(v).trim());

  // Phase 1 adds helper columns after the original data columns,
  // so everything left of "Original Row" is the original record.
  const originalColumnCount = colIndex(headers, "Original Row");
  const originalHeaders = headers.slice(0, originalColumnCount);

  const cStreet = colIndex(headers, "Billing Street");
  const cCity = colIndex(headers, "Billing City");

  const kept: Cell[][] = [];
  const oneWordRows: Cell[][] = [];
  const cityInAddressRows: Cell[][] = [];
  const aptUnitRows: Cell[][] = [];

  for (let i = 1; i < values.length; i++) {
    const row = values[i];

    const street = String(row[cStreet] ?? "").trim();
    const city = String(row[cCity] ?? "").trim();

    const originalRecord = row.slice(0, originalColumnCount);

    let moved = false;

    if (getWordCount(street) === 1) {
      oneWordRows.push(originalRecord);
      moved = true;
    }

    if (streetContainsCity(street, city)) {
      cityInAddressRows.push(originalRecord);
      moved = true;
    }

    if (hasDuplicateAptUnit(street)) {
      aptUnitRows.push(originalRecord);
      moved = true;
    }

    if (!moved) {
      kept.push(row);
    }
  }

  // ----------------------------------
  // CREATE REVIEW TABS
  // ----------------------------------

  const oneWordSheet = getOrCreateReviewSheet(
    workbook, ONE_WORD_SHEET, originalHeaders
  );

  const citySheet = getOrCreateReviewSheet(
    workbook, CITY_IN_ADDRESS_SHEET, originalHeaders
  );

  const aptUnitSheet = getOrCreateReviewSheet(
    workbook, APT_UNIT_SHEET, originalHeaders
  );

  appendRows(oneWordSheet, oneWordRows, originalColumnCount);
  appendRows(citySheet, cityInAddressRows, originalColumnCount);
  appendRows(aptUnitSheet, aptUnitRows, originalColumnCount);

  // ----------------------------------
  // REWRITE DATA SHEET (only if rows moved)
  // ----------------------------------

  const removedCount = values.length - 1 - kept.length;

  if (removedCount > 0) {
    // Clear contents only, so header styling and number formats stay.
    used.clear(ExcelScript.ClearApplyTo.contents);

    const rebuilt: Cell[][] = [headers, ...kept];

    dataSheet
      .getRangeByIndexes(0, 0, rebuilt.length, headers.length)
      .setValues(rebuilt);
  }

  console.log(
    `PHASE 3 COMPLETE

One Word Address: ${oneWordRows.length}
City in Address: ${cityInAddressRows.length}
Apt/Unit Duplicated: ${aptUnitRows.length}

Rows removed from main sheet: ${removedCount}
Remaining rows: ${kept.length}`
  );
}
