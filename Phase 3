/**
 * PHASE 3
 * STREET ADDRESS LENGTH AND DUPLICATE REVIEW
 *
 * Automatically fixes:
 *   1. Entire duplicated addresses
 *      456 Oak Ave 456 Oak Ave
 *      -> 456 Oak Ave
 *
 *   2. Repeated street-ending phrases
 *      123 Main St Main St
 *      -> 123 Main St
 *
 * Flags:
 *   1. Addresses containing 2 words or fewer
 *   2. Addresses containing 5 words or more
 *   3. Possible duplicate Apt/Unit text
 *
 * Does not:
 *   - Change capitalization
 *   - Correct spelling
 *   - Standardize street suffixes
 *
 * Requires:
 *   - Phase 1 completed
 *   - Phase 2 completed
 */

type Cell = string | number | boolean;

const BACKUP_SHEET = "Raw Backup";
const LOG_SHEET = "Changes Log";
const SUMMARY_SHEET = "Summary";

// ----------------------------------------------------
// GENERAL HELPERS
// ----------------------------------------------------

function getColumnIndex(
  headers: string[],
  columnName: string
): number {
  const index = headers.indexOf(columnName);

  if (index === -1) {
    throw new Error(`Required column not found: ${columnName}`);
  }

  return index;
}

function createLogEntry(
  originalRow: Cell,
  accountId: Cell,
  column: string,
  oldValue: Cell,
  newValue: Cell,
  rule: string,
  action: string
): Cell[] {
  return [
    originalRow,
    accountId,
    column,
    oldValue,
    newValue,
    rule,
    action,
    new Date().toISOString()
  ];
}

function appendRows(
  sheet: ExcelScript.Worksheet,
  rows: Cell[][],
  columnCount: number
): void {
  if (rows.length === 0) {
    return;
  }

  const usedRange = sheet.getUsedRange();
  const nextRow = usedRange
    ? usedRange.getRowCount()
    : 0;

  sheet
    .getRangeByIndexes(
      nextRow,
      0,
      rows.length,
      columnCount
    )
    .setValues(rows);
}

function writeColumn(
  sheet: ExcelScript.Worksheet,
  values: Cell[][],
  columnIndex: number
): void {
  const columnValues = values.map(
    row => [row[columnIndex]]
  );

  sheet
    .getRangeByIndexes(
      0,
      columnIndex,
      columnValues.length,
      1
    )
    .setValues(columnValues);
}

// ----------------------------------------------------
// FLAG HELPERS
// ----------------------------------------------------

function appendUniqueText(
  currentValue: Cell,
  newText: string
): string {
  const current = String(currentValue || "").trim();

  if (current === "") {
    return newText;
  }

  const existingItems = current
    .split(";")
    .map(item => item.trim().toLowerCase());

  if (existingItems.includes(newText.toLowerCase())) {
    return current;
  }

  return `${current}; ${newText}`;
}

function addFlag(
  row: Cell[],
  flagColumn: number,
  reasonColumn: number,
  suggestionColumn: number,
  reason: string,
  suggestion: string
): void {
  row[flagColumn] = "REVIEW";

  row[reasonColumn] = appendUniqueText(
    row[reasonColumn],
    reason
  );

  row[suggestionColumn] = appendUniqueText(
    row[suggestionColumn],
    suggestion
  );
}

function getWordCount(value: string): number {
  const trimmed = value.trim();

  if (trimmed === "") {
    return 0;
  }

  return trimmed.split(/\s+/).length;
}

// ----------------------------------------------------
// DUPLICATE STREET DETECTION
// ----------------------------------------------------

function removeEntireDuplicateAddress(
  street: string
): string | null {
  const words = street.trim().split(/\s+/);

  if (
    words.length < 4 ||
    words.length % 2 !== 0
  ) {
    return null;
  }

  const midpoint = words.length / 2;
  const firstHalf = words.slice(0, midpoint).join(" ");
  const secondHalf = words.slice(midpoint).join(" ");

  if (
    firstHalf.toLowerCase() ===
    secondHalf.toLowerCase()
  ) {
    return firstHalf;
  }

  return null;
}

function removeRepeatedEnding(
  street: string
): string | null {
  const suffixes = [
    "street",
    "st",
    "st.",
    "avenue",
    "ave",
    "ave.",
    "road",
    "rd",
    "rd.",
    "drive",
    "dr",
    "dr.",
    "lane",
    "ln",
    "ln.",
    "court",
    "ct",
    "ct.",
    "boulevard",
    "blvd",
    "blvd.",
    "place",
    "pl",
    "pl.",
    "parkway",
    "pkwy",
    "pkwy.",
    "highway",
    "hwy",
    "hwy.",
    "way",
    "circle",
    "cir",
    "cir.",
    "terrace",
    "ter",
    "ter.",
    "trail",
    "trl",
    "trl."
  ];

  for (let index = 0; index < suffixes.length; index++) {
    const suffix = suffixes[index].replace(
      ".",
      "\\."
    );

    const pattern = new RegExp(
      `(.*)\\s+([^\\s]+\\s+${suffix})\\s+\\2$`,
      "i"
    );

    const match = street.match(pattern);

    if (match) {
      return `${match[1].trim()} ${match[2].trim()}`;
    }
  }

  return null;
}

// ----------------------------------------------------
// MAIN
// ----------------------------------------------------

function main(workbook: ExcelScript.Workbook): void {
  const dataSheet = workbook.getActiveWorksheet();

  const excludedSheets = [
    BACKUP_SHEET,
    LOG_SHEET,
    SUMMARY_SHEET
  ];

  if (excludedSheets.includes(dataSheet.getName())) {
    throw new Error(
      "Activate the donor data worksheet before running Phase 3."
    );
  }

  const logSheet = workbook.getWorksheet(LOG_SHEET);
  const summarySheet = workbook.getWorksheet(SUMMARY_SHEET);

  if (!logSheet || !summarySheet) {
    throw new Error(
      `The "${LOG_SHEET}" or "${SUMMARY_SHEET}" worksheet is missing.`
    );
  }

  const usedRange = dataSheet.getUsedRange();

  if (!usedRange) {
    throw new Error("The active worksheet contains no data.");
  }

  const values = usedRange.getValues() as Cell[][];

  if (values.length < 2) {
    throw new Error(
      "The active worksheet must contain headers and at least one data row."
    );
  }

  const headers = values[0].map(
    value => String(value).trim()
  );

  const columns = {
    street: getColumnIndex(
      headers,
      "Billing Street"
    ),
    originalRow: getColumnIndex(
      headers,
      "Original Row"
    ),
    accountId: getColumnIndex(
      headers,
      "Account Case Safe ID"
    ),
    flag: getColumnIndex(
      headers,
      "Flag"
    ),
    reason: getColumnIndex(
      headers,
      "Flag Reason"
    ),
    suggestion: getColumnIndex(
      headers,
      "Suggested Fix"
    )
  };

  const logEntries: Cell[][] = [];

  let duplicateFixCount = 0;
  let shortAddressFlagCount = 0;
  let longAddressFlagCount = 0;
  let duplicateUnitFlagCount = 0;
  let totalFlaggedRowCount = 0;

  for (
    let rowIndex = 1;
    rowIndex < values.length;
    rowIndex++
  ) {
    const row = values[rowIndex];

    const originalRow = row[columns.originalRow];
    const accountId = row[columns.accountId];

    let street = String(
      row[columns.street] || ""
    ).trim();

    let rowFlaggedByPhase = false;

    // ------------------------------------------------
    // ENTIRE DUPLICATE ADDRESS
    // ------------------------------------------------

    const entireDuplicate =
      removeEntireDuplicateAddress(street);

    if (entireDuplicate) {
      logEntries.push(
        createLogEntry(
          originalRow,
          accountId,
          "Billing Street",
          street,
          entireDuplicate,
          "Duplicate street text",
          "Auto-fixed"
        )
      );

      street = entireDuplicate;
      duplicateFixCount++;
    }

    // ------------------------------------------------
    // REPEATED ENDING PHRASE
    // ------------------------------------------------

    const repeatedEnding =
      removeRepeatedEnding(street);

    if (
      repeatedEnding &&
      repeatedEnding !== street
    ) {
      const oldStreet = street;

      street = repeatedEnding;
      duplicateFixCount++;

      logEntries.push(
        createLogEntry(
          originalRow,
          accountId,
          "Billing Street",
          oldStreet,
          street,
          "Duplicate street phrase",
          "Auto-fixed"
        )
      );
    }

    row[columns.street] = street;

    // ------------------------------------------------
    // WORD-COUNT VALIDATION
    // ------------------------------------------------

    const wordCount = getWordCount(street);

    if (wordCount <= 1) {
      const reason = wordCount === 0
        ? "Street address is blank"
        : "Street address contains 1 words or fewer";

      addFlag(
        row,
        columns.flag,
        columns.reason,
        columns.suggestion,
        reason,
        "Verify the complete street address"
      );

      logEntries.push(
        createLogEntry(
          originalRow,
          accountId,
          "Billing Street",
          street,
          street,
          reason,
          "Flagged"
        )
      );

      shortAddressFlagCount++;
      rowFlaggedByPhase = true;
    }

    if (wordCount >= 7) {
      const reason =
        "Street address contains 7 words or more";

      addFlag(
        row,
        columns.flag,
        columns.reason,
        columns.suggestion,
        reason,
        "Verify the complete street address"
      );

      logEntries.push(
        createLogEntry(
          originalRow,
          accountId,
          "Billing Street",
          street,
          street,
          reason,
          "Flagged"
        )
      );

      longAddressFlagCount++;
      rowFlaggedByPhase = true;
    }

    // ------------------------------------------------
    // DUPLICATE APARTMENT OR UNIT TEXT
    // ------------------------------------------------

    const hasDuplicateApartment =
      /\bapt\.?\s+\S+.*\bapt\.?\s+\S+/i
        .test(street);

    const hasDuplicateUnit =
      /\bunit\s+\S+.*\bunit\s+\S+/i
        .test(street);

    if (
      hasDuplicateApartment ||
      hasDuplicateUnit
    ) {
      const reason =
        "Possible duplicate apartment/unit text";

      addFlag(
        row,
        columns.flag,
        columns.reason,
        columns.suggestion,
        reason,
        "Verify apartment or unit information"
      );

      logEntries.push(
        createLogEntry(
          originalRow,
          accountId,
          "Billing Street",
          street,
          street,
          reason,
          "Flagged"
        )
      );

      duplicateUnitFlagCount++;
      rowFlaggedByPhase = true;
    }

    if (rowFlaggedByPhase) {
      totalFlaggedRowCount++;
    }
  }

  // ----------------------------------------------------
  // WRITE MODIFIED COLUMNS
  // ----------------------------------------------------

  writeColumn(
    dataSheet,
    values,
    columns.street
  );

  writeColumn(
    dataSheet,
    values,
    columns.flag
  );

  writeColumn(
    dataSheet,
    values,
    columns.reason
  );

  writeColumn(
    dataSheet,
    values,
    columns.suggestion
  );

  // ----------------------------------------------------
  // LOG AND SUMMARY
  // ----------------------------------------------------

  appendRows(
    logSheet,
    logEntries,
    8
  );

  appendRows(
    summarySheet,
    [
      [
        "Phase 3: duplicate street fixes",
        duplicateFixCount
      ],
      [
        "Phase 3: addresses with 1 word or fewer",
        shortAddressFlagCount
      ],
      [
        "Phase 3: addresses with 7 words or more",
        longAddressFlagCount
      ],
      [
        "Phase 3: duplicate Apt/Unit flags",
        duplicateUnitFlagCount
      ],
      [
        "Phase 3: total rows flagged",
        totalFlaggedRowCount
      ]
    ],
    2
  );

  console.log(
    `PHASE 3 COMPLETE\n` +
    `Duplicate street fixes: ${duplicateFixCount}\n` +
    `Addresses with 1 word or fewer: ${shortAddressFlagCount}\n` +
    `Addresses with 7 words or more: ${longAddressFlagCount}\n` +
    `Duplicate Apt/Unit flags: ${duplicateUnitFlagCount}\n` +
    `Total rows flagged: ${totalFlaggedRowCount}`
  );
}
