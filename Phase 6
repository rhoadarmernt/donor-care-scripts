/**
 * PHASE 6 - GREETING CAPITALIZATION
 *
 * Standardizes capitalization and spacing in:
 * - Formal Greeting
 * - Informal Greeting
 *
 * No greetings are compared.
 * No records are flagged.
 */

type Cell = string | number | boolean;

const LOG_SHEET = "Changes Log";
const SUMMARY_SHEET = "Summary";
const BACKUP_SHEET = "Raw Backup";

//--------------------------------------------------
// HELPERS
//--------------------------------------------------

function getColumnIndex(
  headers: string[],
  columnName: string
): number {
  const index = headers.indexOf(columnName);

  if (index === -1) {
    throw new Error(`Column not found: ${columnName}`);
  }

  return index;
}

function normalizeSpaces(value: string): string {
  return value
    .replace(/\s+/g, " ")
    .trim();
}

function capitalizeNamePart(part: string): string {
  if (!part) {
    return part;
  }

  const lower = part.toLowerCase();

  // McDonald, McArthur, McKinley
  if (/^mc[a-z]/.test(lower)) {
    return (
      "Mc" +
      lower.charAt(2).toUpperCase() +
      lower.substring(3)
    );
  }

  // O'Brien, D'Angelo
  if (/^[a-z]'[a-z]/.test(lower)) {
    return (
      lower.charAt(0).toUpperCase() +
      "'" +
      lower.charAt(2).toUpperCase() +
      lower.substring(3)
    );
  }

  return (
    lower.charAt(0).toUpperCase() +
    lower.substring(1)
  );
}

function capitalizeGreeting(value: string): string {
  const normalized = normalizeSpaces(value)
    .replace(/\s*&\s*/g, " and ");

  if (!normalized) {
    return "";
  }

  const words = normalized.split(" ");
  const output: string[] = [];

  for (const word of words) {
    const lower = word.toLowerCase();

    if (lower === "and") {
      output.push("and");
      continue;
    }

    /*
     * Preserve intentional mixed capitalization when:
     * - The first character is uppercase.
     * - At least one later character is lowercase.
     *
     * Examples:
     * MacArthur
     * DeMarco
     * LaToya
     */
    const isMixedCase =
      word !== word.toUpperCase() &&
      word !== word.toLowerCase();

    const beginsWithUppercase = /^[A-Z]/.test(word);
    const restContainsLowercase = /[a-z]/.test(
      word.substring(1)
    );

    if (
      isMixedCase &&
      beginsWithUppercase &&
      restContainsLowercase
    ) {
      output.push(word);
      continue;
    }

    /*
     * Capitalize each part of a hyphenated name.
     *
     * Example:
     * MARY-ANNE -> Mary-Anne
     */
    const correctedWord = word
      .split("-")
      .map(part => capitalizeNamePart(part))
      .join("-");

    output.push(correctedWord);
  }

  return output.join(" ");
}

function appendRows(
  sheet: ExcelScript.Worksheet,
  rows: Cell[][]
): void {
  if (rows.length === 0) {
    return;
  }

  const nextRow =
    sheet.getUsedRange()?.getRowCount() ?? 0;

  sheet
    .getRangeByIndexes(
      nextRow,
      0,
      rows.length,
      rows[0].length
    )
    .setValues(rows);
}

//--------------------------------------------------
// MAIN
//--------------------------------------------------

function main(workbook: ExcelScript.Workbook): void {
  const sheet = workbook.getActiveWorksheet();

  const excludedSheets = [
    LOG_SHEET,
    SUMMARY_SHEET,
    BACKUP_SHEET,
    "ZipLookup"
  ];

  if (excludedSheets.includes(sheet.getName())) {
    throw new Error(
      "Activate your donor data worksheet first."
    );
  }

  const logSheet = workbook.getWorksheet(LOG_SHEET);
  const summarySheet = workbook.getWorksheet(SUMMARY_SHEET);

  if (!logSheet || !summarySheet) {
    throw new Error("Run Phase 1 first.");
  }

  const usedRange = sheet.getUsedRange();

  if (!usedRange) {
    throw new Error("No data found.");
  }

  const values = usedRange.getValues();

  if (values.length < 2) {
    throw new Error("No donor records found.");
  }

  const headers = values[0].map(value =>
    String(value).trim()
  );

  const cOriginalRow = getColumnIndex(
    headers,
    "Original Row"
  );

  const cAccountId = getColumnIndex(
    headers,
    "Account Case Safe ID"
  );

  const cFormal = getColumnIndex(
    headers,
    "Formal Greeting"
  );

  const cInformal = getColumnIndex(
    headers,
    "Informal Greeting"
  );

  const formalValues: Cell[][] = [];
  const informalValues: Cell[][] = [];
  const logRows: Cell[][] = [];

  const timestamp = new Date().toISOString();

  let formalFixes = 0;
  let informalFixes = 0;

  for (
    let rowIndex = 1;
    rowIndex < values.length;
    rowIndex++
  ) {
    const row = values[rowIndex];

    const originalFormal = String(
      row[cFormal] ?? ""
    );

    const originalInformal = String(
      row[cInformal] ?? ""
    );

    let finalFormal = originalFormal;
    let finalInformal = originalInformal;

    //--------------------------------------------------
    // FORMAL GREETING
    //--------------------------------------------------

    if (originalFormal.trim()) {
      finalFormal = capitalizeGreeting(originalFormal);

      if (finalFormal !== originalFormal) {
        logRows.push([
          row[cOriginalRow],
          row[cAccountId],
          "Formal Greeting",
          originalFormal,
          finalFormal,
          "Greeting capitalization",
          "Auto-fixed",
          timestamp
        ]);

        formalFixes++;
      }
    }

    //--------------------------------------------------
    // INFORMAL GREETING
    //--------------------------------------------------

    if (originalInformal.trim()) {
      finalInformal = capitalizeGreeting(
        originalInformal
      );

      if (finalInformal !== originalInformal) {
        logRows.push([
          row[cOriginalRow],
          row[cAccountId],
          "Informal Greeting",
          originalInformal,
          finalInformal,
          "Greeting capitalization",
          "Auto-fixed",
          timestamp
        ]);

        informalFixes++;
      }
    }

    formalValues.push([finalFormal]);
    informalValues.push([finalInformal]);
  }

  const recordCount = values.length - 1;

  // Write only the columns modified by this phase.
  sheet
    .getRangeByIndexes(
      1,
      cFormal,
      recordCount,
      1
    )
    .setValues(formalValues);

  sheet
    .getRangeByIndexes(
      1,
      cInformal,
      recordCount,
      1
    )
    .setValues(informalValues);

  appendRows(logSheet, logRows);

  appendRows(summarySheet, [
    [
      "Phase 6: Formal Greeting capitalization fixes",
      formalFixes
    ],
    [
      "Phase 6: Informal Greeting capitalization fixes",
      informalFixes
    ],
    [
      "Phase 6: Total greeting capitalization fixes",
      formalFixes + informalFixes
    ]
  ]);

  console.log(
    `PHASE 6 COMPLETE\n\n` +
    `Formal Greeting fixes: ${formalFixes}\n` +
    `Informal Greeting fixes: ${informalFixes}\n` +
    `Total greeting fixes: ${formalFixes + informalFixes
    }`
  );
}
